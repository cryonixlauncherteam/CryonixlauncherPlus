<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#17191E">

    <!-- Lunar-inspired compact navigation rail. Existing button IDs preserve current actions. -->
    <LinearLayout
        android:id="@+id/cryonix_home_rail"
        android:layout_width="58dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="top|center_horizontal"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#15171B"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="14dp"
            android:src="@drawable/ic_px_book"
            android:contentDescription="Cryonix home"
            android:padding="5dp"
            app:tint="#F3F4F6" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/news_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/cryonix_rail_button"
            android:drawableStart="@drawable/ic_px_book"
            android:gravity="center"
            android:padding="0dp"
            android:text=""
            android:contentDescription="@string/mcl_tab_wiki" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/social_media_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/cryonix_rail_button"
            android:drawableStart="@drawable/ic_social_media"
            android:gravity="center"
            android:padding="0dp"
            android:text=""
            android:contentDescription="@string/mcl_button_social_media" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/custom_control_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/cryonix_rail_button"
            android:drawableStart="@drawable/ic_px_gamepad"
            android:gravity="center"
            android:padding="0dp"
            android:text=""
            android:contentDescription="@string/mcl_option_customcontrol" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/install_jar_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/cryonix_rail_button"
            android:drawableStart="@drawable/ic_px_java_run"
            android:gravity="center"
            android:padding="0dp"
            android:text=""
            android:contentDescription="@string/main_install_jar_file" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/share_logs_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/cryonix_rail_button"
            android:drawableStart="@drawable/ic_px_sharelog"
            android:gravity="center"
            android:padding="0dp"
            android:text=""
            android:contentDescription="@string/main_share_logs" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/open_files_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/cryonix_rail_button"
            android:drawableStart="@drawable/ic_px_folder"
            android:gravity="center"
            android:padding="0dp"
            android:text=""
            android:contentDescription="@string/mcl_button_open_directory" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cryonix_home_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="8dp"
        android:paddingBottom="7dp"
        app:layout_constraintStart_toEndOf="@id/cryonix_home_rail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Quick Play strip: deliberately compact, matching the desktop-launcher reference. -->
        <LinearLayout
            android:id="@+id/cryonix_quick_play"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:background="@drawable/cryonix_top_strip"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="▦  QUICK PLAY"
                android:textColor="#F2F3F5"
                android:textStyle="bold"
                android:textSize="10sp"
                android:paddingEnd="16dp" />

            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="H" android:textColor="#F5C65B" android:textStyle="bold" android:textSize="21sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="♛" android:textColor="#7EDB8C" android:textStyle="bold" android:textSize="20sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="N" android:textColor="#FF9B35" android:textStyle="bold" android:textSize="22sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="#55D9B1" android:textStyle="bold" android:textSize="20sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="◉" android:textColor="#A7B8D4" android:textSize="20sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Ⅱ" android:textColor="#E3B64D" android:textSize="20sp" />

            <TextView
                android:id="@+id/cryonix_profile_chip"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:background="@drawable/cryonix_profile_chip"
                android:text="♟  CRYONIX PLAYER"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="10sp" />

            <ImageButton
                android:id="@+id/cryonix_inbox_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/cryonix_rail_button"
                android:src="@drawable/ic_px_book"
                android:contentDescription="Messages"
                android:padding="8dp"
                app:tint="#F3F4F6" />
        </LinearLayout>

        <!-- Hero banner: the actual existing play button is placed here so launching still works. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cryonix_hero_panel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/cryonix_space_hero"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/cryonix_quick_play"
            app:layout_constraintBottom_toTopOf="@id/cryonix_dashboard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_weight="6">

            <TextView
                android:id="@+id/cryonix_hero_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="LAUNCH MINECRAFT"
                android:textColor="#F7FAFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/play_button" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="0dp"
                android:layout_marginStart="70dp"
                android:layout_marginEnd="70dp"
                android:layout_height="52dp"
                android:background="@drawable/cryonix_lunar_launch_button"
                android:text="@string/main_play"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/cryonix_hero_version_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SELECTED VERSION  •  READY TO PLAY"
                android:textColor="#A9D8C2"
                android:textSize="8sp"
                android:letterSpacing="0.12"
                app:layout_constraintTop_toBottomOf="@id/play_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- News cards and friends panel, matching the reference's two-column dashboard. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cryonix_dashboard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/cryonix_hero_panel"
            app:layout_constraintBottom_toTopOf="@id/cryonix_bottom_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_weight="4">

            <TextView
                android:id="@+id/cryonix_news_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LATEST NEWS"
                android:textColor="#F5F5F6"
                android:textStyle="bold"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/cryonix_news_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View all News  ›"
                android:textColor="#B5BAC3"
                android:textSize="8sp"
                app:layout_constraintEnd_toStartOf="@id/cryonix_friends_panel"
                app:layout_constraintTop_toTopOf="@id/cryonix_news_title"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:id="@+id/cryonix_news_cards"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="7dp"
                android:orientation="horizontal"
                android:gravity="top"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cryonix_friends_panel"
                app:layout_constraintTop_toBottomOf="@id/cryonix_news_title"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/cryonix_news_card_a"
                    android:text="AQUATIC\nCOLLECTION"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:shadowColor="#AA000000"
                    android:shadowRadius="5" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/cryonix_news_card_b"
                    android:text="MINECRAFT\nEXPLORE MORE"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:shadowColor="#AA000000"
                    android:shadowRadius="5" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cryonix_friends_panel"
                android:layout_width="31%"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="3dp"
                android:background="#17191E"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FRIENDS"
                    android:textColor="#F5F5F6"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:paddingBottom="6dp" />

                <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="7dp" android:background="@drawable/cryonix_friend_row" android:text="🟩  PlayerOne\n      Playing Minecraft" android:textColor="#F0F1F3" android:textSize="10sp" />
                <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="7dp" android:layout_marginTop="3dp" android:background="@drawable/cryonix_friend_row" android:text="🟪  BlockBuilder\n      Online in Launcher" android:textColor="#F0F1F3" android:textSize="10sp" />
                <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="7dp" android:layout_marginTop="3dp" android:background="@drawable/cryonix_friend_row" android:text="🟧  CraftKing\n      Playing Multiplayer" android:textColor="#F0F1F3" android:textSize="10sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Keep version and edit controls wired to the original launcher logic. -->
        <LinearLayout
            android:id="@+id/cryonix_bottom_bar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/cryonix_bottom_panel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:drawableEnd="@drawable/spinner_arrow"
                android:paddingStart="4dp"
                app:drawableEndPadding="2dp"
                app:drawableEndSize="12dp"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="30dp"
                tools:ignore="RtlSymmetry" />

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/cryonix_icon_button"
                android:contentDescription="Edit selected instance"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_px_edit"
                app:tint="#DDE8F5" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>