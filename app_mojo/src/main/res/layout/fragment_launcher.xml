<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/sidebar_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.30" />

    <View
        android:id="@+id/sidebar_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@color/background_bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/sidebar_guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/cryonix_sidebar_brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:text="CRYONIX"
        android:textColor="@color/primary_text"
        android:textStyle="bold"
        android:textSize="@dimen/_14ssp"
        android:letterSpacing="0.08"
        app:layout_constraintStart_toStartOf="@id/sidebar_panel"
        app:layout_constraintEnd_toEndOf="@id/sidebar_panel"
        app:layout_constraintTop_toTopOf="@id/sidebar_panel" />

    <TextView
        android:id="@+id/sidebar_section_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:text="QUICK ACCESS"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/_8ssp"
        android:letterSpacing="0.12"
        app:layout_constraintStart_toStartOf="@id/sidebar_panel"
        app:layout_constraintEnd_toEndOf="@id/sidebar_panel"
        app:layout_constraintTop_toBottomOf="@id/cryonix_sidebar_brand" />

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/news_button"
        style="@style/LauncherMenuButton.Universal"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        android:text="@string/mcl_tab_wiki"
        android:drawableStart="@drawable/ic_px_book"
        app:layout_constraintTop_toBottomOf="@id/sidebar_section_label"
        app:layout_constraintStart_toStartOf="@id/sidebar_panel"
        app:layout_constraintEnd_toEndOf="@id/sidebar_panel" />

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/social_media_button"
        style="@style/LauncherMenuButton.Universal"
        android:layout_width="0dp"
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:text="@string/mcl_button_social_media"
        android:drawableStart="@drawable/ic_social_media"
        app:layout_constraintTop_toBottomOf="@id/news_button"
        app:layout_constraintStart_toStartOf="@id/sidebar_panel"
        app:layout_constraintEnd_toEndOf="@id/sidebar_panel" />

    <View
        android:id="@+id/sidebar_separator"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginVertical="@dimen/_4sdp"
        android:background="@color/background_overlay"
        app:layout_constraintTop_toBottomOf="@id/social_media_button"
        app:layout_constraintStart_toStartOf="@id/sidebar_panel"
        app:layout_constraintEnd_toEndOf="@id/sidebar_panel" />

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/custom_control_button"
        style="@style/LauncherMenuButton.Universal"
        android:layout_width="0dp"
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:text="@string/mcl_option_customcontrol"
        android:drawableStart="@drawable/ic_px_gamepad"
        app:layout_constraintTop_toBottomOf="@id/sidebar_separator"
        app:layout_constraintStart_toStartOf="@id/sidebar_panel"
        app:layout_constraintEnd_toEndOf="@id/sidebar_panel" />

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/install_jar_button"
        style="@style/LauncherMenuButton.Universal"
        android:layout_width="0dp"
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:text="@string/main_install_jar_file"
        android:drawableStart="@drawable/ic_px_java_run"
        app:layout_constraintTop_toBottomOf="@id/custom_control_button"
        app:layout_constraintStart_toStartOf="@id/sidebar_panel"
        app:layout_constraintEnd_toEndOf="@id/sidebar_panel" />

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/share_logs_button"
        style="@style/LauncherMenuButton.Universal"
        android:layout_width="0dp"
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:text="@string/main_share_logs"
        android:drawableStart="@drawable/ic_px_sharelog"
        app:layout_constraintTop_toBottomOf="@id/install_jar_button"
        app:layout_constraintStart_toStartOf="@id/sidebar_panel"
        app:layout_constraintEnd_toEndOf="@id/sidebar_panel" />

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/open_files_button"
        style="@style/LauncherMenuButton.Universal"
        android:layout_width="0dp"
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:text="@string/mcl_button_open_directory"
        android:drawableStart="@drawable/ic_px_folder"
        app:layout_constraintTop_toBottomOf="@id/share_logs_button"
        app:layout_constraintStart_toStartOf="@id/sidebar_panel"
        app:layout_constraintEnd_toEndOf="@id/sidebar_panel" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/main_content_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.32" />

    <TextView
        android:id="@+id/hero_eyebrow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:text="MINECRAFT JAVA EDITION"
        android:textColor="@color/cryonix_blue"
        android:textSize="@dimen/_9ssp"
        android:textStyle="bold"
        android:letterSpacing="0.14"
        app:layout_constraintStart_toEndOf="@id/main_content_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/hero_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:text="Your world. Your rules."
        android:textColor="@color/primary_text"
        android:textSize="@dimen/_22ssp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/main_content_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hero_eyebrow" />

    <TextView
        android:id="@+id/hero_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_18sdp"
        android:text="A cleaner way to play Java Edition on Android."
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintStart_toEndOf="@id/main_content_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hero_title" />

    <View
        android:id="@+id/hero_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_18sdp"
        android:background="@color/background_overlay"
        app:layout_constraintStart_toEndOf="@id/main_content_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hero_subtitle" />

    <TextView
        android:id="@+id/instance_section_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="SELECTED INSTANCE"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/_9ssp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintStart_toEndOf="@id/main_content_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hero_divider" />

    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="0dp"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginStart="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_marginEnd="@dimen/_6sdp"
        android:background="@drawable/background_card"
        android:drawableEnd="@drawable/spinner_arrow"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_8sdp"
        app:drawableEndSize="@dimen/padding_heavy"
        app:drawableStartIntegerScaling="true"
        app:drawableStartSize="@dimen/_32sdp"
        app:drawableEndPadding="@dimen/_1sdp"
        app:layout_constraintBottom_toTopOf="@id/play_button"
        app:layout_constraintEnd_toStartOf="@id/edit_profile_button"
        app:layout_constraintStart_toEndOf="@id/main_content_guideline"
        app:layout_constraintTop_toBottomOf="@id/instance_section_title" />

    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="@dimen/_42sdp"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Edit selected instance"
        android:src="@drawable/ic_px_edit"
        app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

    <View
        android:id="@+id/_background_display_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_10sdp"
        android:background="@color/background_bottom_bar"
        android:translationZ="-1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/main_content_guideline"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="0dp"
        android:layout_height="@dimen/_54sdp"
        android:layout_marginStart="@dimen/_18sdp"
        android:layout_marginEnd="@dimen/_18sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:text="LAUNCH MINECRAFT"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/main_content_guideline" />

</androidx.constraintlayout.widget.ConstraintLayout>
