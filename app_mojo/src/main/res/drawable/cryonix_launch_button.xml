<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="9dp"/><solid android:color="#0868C8"/><stroke android:width="1dp" android:color="#65B7FF"/></shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><corners android:radius="9dp"/><solid android:color="#34495D"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="9dp"/><solid android:color="#168BFF"/><stroke android:width="1dp" android:color="#4EA9FF"/></shape>
    </item>
</selector>