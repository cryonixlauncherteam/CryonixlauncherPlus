<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cryonix_landscape_texture">

    <!-- Compact utility rail: kept narrow for Android landscape screens. -->
    <LinearLayout
        android:id="@+id/cryonix_home_rail"
        android:layout_width="154dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#D90B111A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="CRYONIX"
            android:textColor="#EAF3FF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.08" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:background="#29394B" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/news_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/cryonix_rail_button"
            android:drawableStart="@drawable/ic_px_book"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:text="@string/mcl_tab_wiki"
            android:textColor="#C8D4E2"
            android:textSize="11sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/social_media_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/cryonix_rail_button"
            android:drawableStart="@drawable/ic_social_media"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:text="@string/mcl_button_social_media"
            android:textColor="#C8D4E2"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginVertical="5dp"
            android:background="#29394B" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/custom_control_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/cryonix_rail_button"
            android:drawableStart="@drawable/ic_px_gamepad"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:text="@string/mcl_option_customcontrol"
            android:textColor="#C8D4E2"
            android:textSize="11sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/install_jar_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/cryonix_rail_button"
            android:drawableStart="@drawable/ic_px_java_run"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:text="@string/main_install_jar_file"
            android:textColor="#C8D4E2"
            android:textSize="11sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/share_logs_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/cryonix_rail_button"
            android:drawableStart="@drawable/ic_px_sharelog"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:text="@string/main_share_logs"
            android:textColor="#C8D4E2"
            android:textSize="11sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/open_files_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/cryonix_rail_button"
            android:drawableStart="@drawable/ic_px_folder"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:text="@string/mcl_button_open_directory"
            android:textColor="#C8D4E2"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Main hero area, inspired by PC launchers but scaled for mobile landscape. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cryonix_home_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toEndOf="@id/cryonix_home_rail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/cryonix_home_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRYONIX LAUNCHER PLUS"
            android:textColor="#F2F7FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/cryonix_home_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="MINECRAFT JAVA EDITION  •  READY TO PLAY"
            android:textColor="#8FA5BD"
            android:textSize="9sp"
            android:letterSpacing="0.08"
            app:layout_constraintStart_toStartOf="@id/cryonix_home_title"
            app:layout_constraintTop_toBottomOf="@id/cryonix_home_title" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cryonix_hero_panel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/cryonix_hero_panel"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/cryonix_home_subtitle"
            app:layout_constraintBottom_toTopOf="@id/cryonix_bottom_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:id="@+id/cryonix_hero_accent"
                android:layout_width="3dp"
                android:layout_height="0dp"
                android:background="#168BFF"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/cryonix_hero_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="YOUR WORLD. YOUR RULES."
                android:textColor="#72B9FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                app:layout_constraintStart_toEndOf="@id/cryonix_hero_accent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/cryonix_hero_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="7dp"
                android:text="Ready for your\nnext adventure?"
                android:textColor="#F4F8FF"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/cryonix_hero_accent"
                app:layout_constraintTop_toBottomOf="@id/cryonix_hero_eyebrow"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/cryonix_hero_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="6dp"
                android:text="Choose an instance below and jump straight into Minecraft."
                android:textColor="#A9B9CB"
                android:textSize="11sp"
                app:layout_constraintStart_toEndOf="@id/cryonix_hero_accent"
                app:layout_constraintTop_toBottomOf="@id/cryonix_hero_heading"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/cryonix_hero_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/cryonix_status_chip"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="JAVA  •  MODDED  •  YOUR SETUP"
                android:textColor="#C9E5FF"
                android:textSize="9sp"
                app:layout_constraintStart_toEndOf="@id/cryonix_hero_accent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/cryonix_bottom_bar"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/cryonix_bottom_panel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:drawableEnd="@drawable/spinner_arrow"
                android:paddingStart="4dp"
                app:drawableEndPadding="2dp"
                app:drawableEndSize="12dp"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="32dp"
                tools:ignore="RtlSymmetry" />

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/cryonix_icon_button"
                android:contentDescription="@string/mcl_option_edit_profile"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_px_edit"
                app:tint="#BBD9F8" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="148dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/cryonix_launch_button"
                android:text="@string/main_play"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>